extends RefCounted
const B = preload("res://balance.gd")
const L = preload("res://layout.gd")
const A = preload("res://arcane_mechanics.gd")
const KEYS = ["blink_blade","arcane_golem","arcane_archer","chronomancer","phase_rider"]
static func run(t) -> void:
	var p := L.cell_center(Vector2i(3,2))
	for key: String in KEYS:
		for lord: String in B.LORDS: t.check(B.card_allowed(key,lord) == (B.lord_faction(lord) == "magic"),key+" faction "+lord)
	for team: int in [0,1]:
		var m = t.bare()
		var dir := 1.0 if team == 0 else -1.0
		var u: Dictionary = m.spawn_unit(team,2,"blink_blade",p)
		for i in range(4): m.damage(u,1,1-team,"rain")
		t.check(is_equal_approx(u.pos.x,p.x+dir*L.CELL_SIZE.x),"four hits blink one cell")
		var behind: Dictionary = m.spawn_unit(1-team,2,"knight",u.pos-Vector2(dir*5,0))
		var front: Dictionary = m.spawn_unit(1-team,2,"knight",u.pos+Vector2(dir*35,0))
		m.build_lookups()
		t.check(m.choose_target(u,B.CARDS.blink_blade) == front,"blink prefers front over nearer rear")
		front.hp = 0
		t.check(m.choose_target(u,B.CARDS.blink_blade).is_empty(),"units do not attack enemies behind them")
		u.pos.x = L.gate_stop(1-team)-dir
		m.damage(u,1,1-team,"rain")
		t.check(is_equal_approx(u.pos.x,L.gate_stop(1-team)),"blink stops at gate")
		m.gates[1-team][2] = 0
		m.damage(u,1,1-team,"rain")
		t.check(is_equal_approx(u.pos.x,L.gate_stop(1-team)),"broken gate still blocks blink")
	for count: int in range(5):
		var m = t.bare()
		var golem: Dictionary = m.spawn_unit(0,2,"arcane_golem",p)
		for i: int in range(count): m.add_building(0,Vector2i(0,i),"crystal")
		m.damage(golem,100,1,"rain")
		t.check(is_equal_approx(golem.hp,1500-100*(1-minf(count*.1,.3))),"resonance stack "+str(count))
		for b: Dictionary in m.buildings: b.hp = 0
		var hp: float = golem.hp
		m.damage(golem,100,1,"rain")
		t.check(is_equal_approx(golem.hp,hp-100),"dead crystals immediately stop resonance")
	var m = t.bare()
	var golem: Dictionary = m.spawn_unit(0,2,"arcane_golem",p+Vector2(45,0))
	golem.hp -= 500
	var worker: Dictionary = m.spawn_unit(0,2,"artificer",p)
	var farm: Dictionary = m.add_building(0,Vector2i(3,2),"farm")
	farm.hp = 1
	A.repair(m,worker,1)
	t.check(golem.hp == 1000+B.CARDS.artificer.repair_amount and farm.hp == 1,"golem repair priority")
	t.check(worker.pos.x > p.x and worker.pos.x-p.x <= B.CARDS.arcane_golem.speed,"repair follows at golem speed")
	var victim: Dictionary = m.spawn_unit(1,2,"knight",golem.pos)
	m.damage(golem,99999,1,"rain")
	m.resolve_deaths()
	t.check(victim.hp == victim.max_hp-B.CARDS.arcane_golem.explosion_damage,"golem death explosion")
	m = t.bare()
	var shooter: Dictionary = m.spawn_unit(0,2,"arcane_archer",p)
	var target: Dictionary = m.spawn_unit(1,2,"knight",p+Vector2(40,0))
	var bandit: Dictionary = m.spawn_unit(1,2,"bandit",p+Vector2(100,0))
	var bird: Dictionary = m.spawn_unit(1,2,"raven",p+Vector2(150,0))
	var adjacent: Dictionary = m.spawn_unit(1,1,"knight",p+Vector2(100,-L.CELL_SIZE.y))
	m.attack(shooter,target)
	t.check(target.hp == target.max_hp,"beam waits for flight")
	var beyond: Dictionary = m.spawn_unit(1,2,"knight",p+Vector2(B.CARDS.arcane_archer.range*2,0))
	var outside: Dictionary = m.spawn_unit(1,2,"knight",p+Vector2(B.CARDS.arcane_archer.range*2+1,0))
	m.update_projectiles(B.ARROW_TIME/2)
	t.check(beyond.hp == beyond.max_hp,"extended arrow has not reached far target halfway")
	t.check(m.projectiles[0].pos.x > p.x,"arrow physically travels")
	m.update_projectiles(B.ARROW_TIME/2)
	t.check(beyond.hp == beyond.max_hp-B.CARDS.arcane_archer.damage and outside.hp == outside.max_hp,"pierce reaches double range boundary only")
	t.check(target.hp == target.max_hp-B.CARDS.arcane_archer.damage,"piercing arrow hits each troop only once")
	t.check(target.hp < target.max_hp and bandit.hp < bandit.max_hp and bird.hp < bird.max_hp and not bandit.stealthed,"pierces flying and reveals bandit")
	t.check(adjacent.hp == adjacent.max_hp,"beam stays in lane")
	m = t.bare()
	var caster: Dictionary = m.spawn_unit(0,2,"chronomancer",p)
	target = m.spawn_unit(1,2,"knight",p+Vector2(80,0))
	var longer: Dictionary = m.spawn_unit(1,2,"knight",target.pos)
	longer.stun_left = 2.0
	m.lords[1].pos = target.pos
	m.attack(caster,target)
	t.check(target.stun_left == .5 and longer.stun_left == 2.0 and not m.lords[1].has("stun_left"),"stun refresh troop only")
	var old: Vector2 = target.pos
	m.build_lookups()
	m.update_unit(target,.1)
	t.check(target.pos == old,"stun prevents movement")
	m = t.bare()
	var rider: Dictionary = m.spawn_unit(0,2,"phase_rider",p)
	target = m.spawn_unit(1,2,"knight",p+Vector2(10,0))
	var trap: Dictionary = m.add_building(1,Vector2i(3,2),"blast_trap")
	m.build_lookups()
	t.check(m.choose_target(target,B.CARDS.knight).is_empty(),"phase cannot be targeted")
	t.check(m.choose_target(rider,B.CARDS.phase_rider).is_empty(),"phase ignores troops and traps")
	A.update_traps(m)
	t.check(rider.hp == rider.max_hp,"phase does not trigger trap")
	m.damage(rider,20,1,"rain")
	t.check(rider.hp == rider.max_hp-20 and rider.stealthed and rider.phased,"AOE hurts but does not end phase")
	m.elapsed = 999
	m.update_unit(rider,.1)
	t.check(rider.pos.x > p.x and rider.phased,"phase unlimited and passes enemy")
	var trigger: Dictionary = m.spawn_unit(0,2,"knight",trap.pos)
	var before_hp: float = rider.hp
	A.update_traps(m)
	t.check(rider.hp < before_hp and rider.phased and trigger.hp < trigger.max_hp,"another troop triggers AOE that hurts phased rider")
	var wall: Dictionary = m.add_building(1,Vector2i(4,2),"barricade")
	m.attack(rider,wall)
	t.check(not rider.phased and not rider.stealthed and wall.hp < wall.max_hp,"first building attack reveals")
	for team: int in [0,1]:
		m = t.bare()
		rider = m.spawn_unit(team,2,"phase_rider",Vector2(L.gate_stop(1-team),p.y))
		m.build_lookups()
		for i: int in range(30): # the attack winds up first (attack_windup.gd)
			if not rider.phased: break
			m.march(rider,B.CARDS.phase_rider,0.01)
		t.check(not rider.phased,"gate attack reveals both teams")
		shooter = m.spawn_unit(team,2,"hunter",p)
		target = m.spawn_unit(1-team,2,"knight",p+Vector2(100 if team == 0 else -100,0))
		m.shoot(shooter,target,10)
		t.check(m.projectiles[0].start.y < shooter.pos.y+shooter.get("dy",0.0)-20 and m.projectiles[0].direction == (1 if team == 0 else -1),"arrow bow origin and mirrored heading")
	t.check(B.CARDS.hunter.interval == B.tier_value("interval","E") and B.CARDS.hunter.range == B.tier_value("range","S"),"hunter interval and range raised one tier")
	m = t.bare()
	shooter = m.spawn_unit(0,2,"arcane_archer",p)
	m.lords[1].pos = p+Vector2(40,0)
	var lord_hp: float = m.lords[1].hp
	m.attack(shooter,m.lords[1])
	m.update_projectiles(B.ARROW_TIME)
	t.check(m.lords[1].hp == lord_hp-B.CARDS.arcane_archer.damage,"piercing arrow damages targeted lord")
	var building: Dictionary = m.add_building(1,Vector2i(4,2),"barricade")
	var building_hp: float = building.hp
	m.attack(shooter,building)
	m.update_projectiles(B.ARROW_TIME)
	t.check(building.hp == building_hp-B.CARDS.arcane_archer.damage,"piercing arrow damages primary building")
	shooter.pos.x = L.gate_stop(1)
	var gate_hp: float = m.gates[1][2]
	A.shoot_piercing_arrow(m,shooter)
	m.update_projectiles(B.ARROW_TIME)
	t.check(m.gates[1][2] == gate_hp-B.CARDS.arcane_archer.damage,"piercing arrow damages gate")
	t.finished.magic_units = true
