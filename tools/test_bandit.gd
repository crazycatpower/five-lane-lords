extends SceneTree
const M = preload("res://battle.gd")
const B = preload("res://balance.gd")
const L = preload("res://layout.gd")
func _initialize():
	var m = M.new(4)
	m.units.clear()
	m.buildings.clear()
	var thief = m.spawn_unit(1,2,"bandit",Vector2(800,394))
	var guard = m.spawn_unit(0,2,"hunter",Vector2(740,394))
	m.build_lookups()
	assert(thief.stealthed)
	assert(m.choose_target(guard,B.CARDS.hunter).is_empty())
	m.lords[0].pos = Vector2(760,394)
	assert(m.lord_target(m.lords[0]).is_empty())
	var reaper = m.spawn_unit(0,2,"reaper",Vector2(750,394))
	m.build_lookups()
	assert(m.reaper_target(reaper).is_empty())
	var catapult = m.spawn_unit(0,2,"catapult",Vector2(600,394))
	m.build_lookups()
	assert(m.catapult_target(catapult).is_empty())
	m.attack(thief,guard)
	assert(not thief.stealthed)
	assert(not m.choose_target(guard,B.CARDS.hunter).is_empty())
	var hidden = m.spawn_unit(1,2,"bandit",Vector2(900,394))
	m.cast_spell({"kind":"rain","team":0,"pos":hidden.pos})
	assert(hidden.stealthed and hidden.hp < hidden.max_hp) # AOE damages but only attack or detection breaks stealth
	# Test attack breaks stealth permanently
	var target_foe = m.spawn_unit(0,2,"militia",hidden.pos+Vector2(20,0))
	m.attack(hidden, target_foe)
	assert(not hidden.stealthed)
	for lord in B.LORDS: assert(B.card_allowed("bandit",lord))
	assert(B.validate().is_empty())
	assert(B.card_description("bandit").contains("潛行"))
	print("Bandit neutrality, targeting, reveal and area damage: PASS")
	quit()
